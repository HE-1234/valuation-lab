  "text.5d1f198cab845d624232": "相對中點的誤差",
  "text.150fcdf6df515beba3fa": "above_approximate_point",
  "text.0682c5f2076f099c34cf": "原始",
  "text.5c09fd8f4d1087caf96d": "評分說明",
